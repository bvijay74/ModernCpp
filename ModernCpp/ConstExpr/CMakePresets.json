{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-clang",
      "hidden": true,
      "inherits": "base",
      "description": "clang-cl from Visual Studio's 'C++ Clang Compiler for Windows' component, with Microsoft's standard library",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "windows-clang-x64"
        }
      }
    },
    {
      "name": "unix-clang",
      "hidden": true,
      "inherits": "base",
      "description": "clang++ on Linux, macOS or WSL",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-clang-cpp14",
      "displayName": "Clang (Windows) C++14",
      "inherits": "windows-clang",
      "cacheVariables": {
        "CONSTEXPR_CXX_STANDARD": "14"
      }
    },
    {
      "name": "windows-clang-cpp17",
      "displayName": "Clang (Windows) C++17",
      "inherits": "windows-clang",
      "cacheVariables": {
        "CONSTEXPR_CXX_STANDARD": "17"
      }
    },
    {
      "name": "windows-clang-cpp20",
      "displayName": "Clang (Windows) C++20",
      "inherits": "windows-clang",
      "cacheVariables": {
        "CONSTEXPR_CXX_STANDARD": "20"
      }
    },
    {
      "name": "windows-clang-cpp23",
      "displayName": "Clang (Windows) C++23",
      "inherits": "windows-clang",
      "cacheVariables": {
        "CONSTEXPR_CXX_STANDARD": "23"
      }
    },
    {
      "name": "clang-cpp11",
      "displayName": "Clang C++11",
      "inherits": "unix-clang",
      "cacheVariables": {
        "CONSTEXPR_CXX_STANDARD": "11"
      }
    },
    {
      "name": "clang-cpp14",
      "displayName": "Clang C++14",
      "inherits": "unix-clang",
      "cacheVariables": {
        "CONSTEXPR_CXX_STANDARD": "14"
      }
    },
    {
      "name": "clang-cpp17",
      "displayName": "Clang C++17",
      "inherits": "unix-clang",
      "cacheVariables": {
        "CONSTEXPR_CXX_STANDARD": "17"
      }
    },
    {
      "name": "clang-cpp20",
      "displayName": "Clang C++20",
      "inherits": "unix-clang",
      "cacheVariables": {
        "CONSTEXPR_CXX_STANDARD": "20"
      }
    },
    {
      "name": "clang-cpp23",
      "displayName": "Clang C++23",
      "inherits": "unix-clang",
      "cacheVariables": {
        "CONSTEXPR_CXX_STANDARD": "23"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-clang-cpp14",
      "configurePreset": "windows-clang-cpp14",
      "displayName": "Clang (Windows) C++14"
    },
    {
      "name": "windows-clang-cpp17",
      "configurePreset": "windows-clang-cpp17",
      "displayName": "Clang (Windows) C++17"
    },
    {
      "name": "windows-clang-cpp20",
      "configurePreset": "windows-clang-cpp20",
      "displayName": "Clang (Windows) C++20"
    },
    {
      "name": "windows-clang-cpp23",
      "configurePreset": "windows-clang-cpp23",
      "displayName": "Clang (Windows) C++23"
    },
    {
      "name": "clang-cpp11",
      "configurePreset": "clang-cpp11",
      "displayName": "Clang C++11"
    },
    {
      "name": "clang-cpp14",
      "configurePreset": "clang-cpp14",
      "displayName": "Clang C++14"
    },
    {
      "name": "clang-cpp17",
      "configurePreset": "clang-cpp17",
      "displayName": "Clang C++17"
    },
    {
      "name": "clang-cpp20",
      "configurePreset": "clang-cpp20",
      "displayName": "Clang C++20"
    },
    {
      "name": "clang-cpp23",
      "configurePreset": "clang-cpp23",
      "displayName": "Clang C++23"
    }
  ]
}
